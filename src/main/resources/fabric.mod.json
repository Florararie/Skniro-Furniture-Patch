{
	"schemaVersion": 1,
	"id": "skniro_furniture_patch",
	"version": "${version}",
	"name": "Polymer Patch for Skniro's Furniture",
	"description": "Server-side-only Skniro's Furniture: every piece renders from its own models and textures for unmodded clients.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"eu.pb4.sknirofurniturepatch.SkniroFurniturePatch"
		]
	},
	"mixins": [
		"skniro-furniture-patch.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-core": ">=0.16.0",
		"polymer-blocks": ">=0.16.0",
		"polymer-virtual-entity": ">=0.16.0",
		"polymer-resource-pack": ">=0.16.0",
		"polymer-resource-pack-extras": ">=0.16.0",
		"sgui": ">=2.0.0",
		"skniro_furniture": "*"
	}
}
